{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/__tests__/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "*.config.ts"],
      "ignoreDependencies": [
        "@typescript/native",
        "git-cliff",
        "nx-oxlint",
        "oxlint",
        "oxlint-tsgolint",
        "tsx"
      ]
    },
    "packages/aitrack-lib": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/aitrack": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test-fixtures": {
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "exports": "error",
    "types": "error"
  }
}

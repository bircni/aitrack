{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "ignoreBinaries": ["hdiutil", "7z"],
      "entry": ["scripts/*.ts", "scripts/__tests__/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "*.config.ts"],
      "ignoreDependencies": [
        "@typescript/native",
        "git-cliff",
        "nx-oxlint",
        "oxlint",
        "oxlint-tsgolint",
        "tsx"
      ]
    },
    "libs/aitrack-lib": {
      "entry": ["src/index.ts", "src/display/checkResult.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/aitrack": {
      "ignoreBinaries": ["explorer.exe"],
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/opentrack-ui": {
      "entry": ["src/sidecar/index.ts", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,svelte}"]
    },
    "libs/test-fixtures": {
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "exports": "error",
    "types": "error"
  }
}

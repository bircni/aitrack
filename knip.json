{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/__tests__/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "*.config.ts"],
      "ignoreDependencies": [
        "@typescript/native",
        "git-cliff",
        "nx-oxlint",
        "oxlint",
        "oxlint-tsgolint",
        "tsx"
      ]
    },
    "packages/aitrack-lib": {
      "entry": ["src/index.ts", "src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/aitrack": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test-fixtures": {
      "project": ["src/**/*.ts"]
    },
    "packages/aitrack-desktop": {
      "entry": [
        "e2e/**/*.ts",
        "src/main/index.ts",
        "src/main/ingestWorker.ts",
        "src/**/__tests__/**/*.test.ts",
        "src/**/__tests__/**/*.test.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts", "e2e/**/*.ts"],
      "ignoreDependencies": ["pdfkit", "tailwindcss"]
    }
  },
  "rules": {
    "exports": "error",
    "types": "error"
  }
}

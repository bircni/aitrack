{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": false,
  "workspaces": {
    ".": {
      "ignoreBinaries": ["hdiutil", "7z", "dpkg-deb", "just", "tsc"],
      "entry": ["scripts/*.ts", "scripts/__tests__/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["git-cliff", "oxlint", "oxlint-tsgolint"]
    },
    "apps/opentrack-ui": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,svelte}"]
    }
  },
  "rules": {
    "exports": "error",
    "types": "error"
  }
}

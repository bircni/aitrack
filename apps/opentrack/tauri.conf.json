{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "opentrack",
  "version": "../../package.json",
  "mainBinaryName": "opentrack",
  "identifier": "dev.bircni.opentrack",
  "build": {
    "frontendDist": "../opentrack-ui/dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "opentrack",
        "width": 320,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTk5RTc3QkFBMURBQzEKUldUQjJxRzZkNTRadkdJTDNlb0l2NDNBVTVkbzFBSDdnUzl6ZHp6eXJDQWw4SXJpMFR0VVU0TU4K",
      "endpoints": ["https://github.com/bircni/aitrack/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "publisher": "bircni",
    "homepage": "https://github.com/bircni/aitrack/blob/main/docs/opentrack.md",
    "shortDescription": "Live limits, reset times and spend for Claude Code, Codex and Cursor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../opentrack-ui/dist-sidecar/opentrack-sidecar.exe": "opentrack-sidecar.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "opentrack",
  "projectType": "application",
  "sourceRoot": "apps/opentrack/src",
  "implicitDependencies": ["opentrack-ui"],
  "targets": {
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*.rs", "{workspaceRoot}/rustfmt.toml", "rustToolchain"],
      "options": {
        "command": "cargo fmt --check -p opentrack"
      }
    },
    "build": {
      "executor": "@monodon/rust:build",
      "cache": false,
      "inputs": [
        "production",
        "^production",
        "rustToolchain",
        "{workspaceRoot}/package.json",
        "cargo"
      ],
      "dependsOn": ["opentrack-ui:build"],
      "outputs": ["{workspaceRoot}/target/debug"],
      "options": {}
    },
    "test": {
      "executor": "@monodon/rust:test",
      "inputs": [
        "default",
        "^production",
        "rustToolchain",
        "{workspaceRoot}/package.json",
        "cargo"
      ],
      "dependsOn": ["opentrack-ui:build"],
      "options": {}
    },
    "lint": {
      "executor": "@monodon/rust:lint",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "rustToolchain",
        "{workspaceRoot}/package.json",
        "cargo"
      ],
      "dependsOn": ["opentrack-ui:build"],
      "options": { "all-targets": true, "args": ["-D", "warnings"] }
    },
    "dev": {
      "executor": "@monodon/rust:run",
      "dependsOn": ["opentrack-ui:build"],
      "continuous": true,
      "options": {}
    },
    "bundle:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "inputs": ["default", "^production", "{workspaceRoot}/scripts/smoke-opentrack-bundle.ts"],
      "options": {
        "command": "node scripts/smoke-opentrack-bundle.ts"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["opentrack-ui:build"],
      "outputs": ["{workspaceRoot}/target/release/bundle"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tauri build"
      },
      "configurations": {
        "release": {
          "command": "tauri build --config tauri.updater.conf.json"
        }
      }
    }
  }
}

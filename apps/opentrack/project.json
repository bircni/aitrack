{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "opentrack",
  "projectType": "application",
  "sourceRoot": "apps/opentrack/src",
  "implicitDependencies": ["opentrack-ui"],
  "targets": {
    "format:check": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/rustfmt.toml", "rustToolchain"],
      "options": {
        "command": "cargo fmt --check -p opentrack"
      }
    },
    "build": {
      "executor": "@monodon/rust:build",
      "inputs": ["production", "^production", "rustToolchain", "{workspaceRoot}/package.json"],
      "dependsOn": ["opentrack-ui:build", "opentrack-ui:sea"],
      "outputs": ["{workspaceRoot}/target/debug"],
      "options": {}
    },
    "test": {
      "executor": "@monodon/rust:test",
      "inputs": ["default", "^production", "rustToolchain", "{workspaceRoot}/package.json"],
      "dependsOn": ["opentrack-ui:build", "opentrack-ui:sea"],
      "options": {}
    },
    "lint": {
      "executor": "@monodon/rust:lint",
      "inputs": ["default", "^production", "rustToolchain", "{workspaceRoot}/package.json"],
      "dependsOn": ["opentrack-ui:build", "opentrack-ui:sea"],
      "options": { "all-targets": true, "args": ["-D", "warnings"] }
    },
    "dev": {
      "executor": "@monodon/rust:run",
      "dependsOn": ["opentrack-ui:build", "opentrack-ui:sea"],
      "continuous": true,
      "options": {}
    },
    "bundle:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "options": {
        "command": "node scripts/smoke-opentrack-bundle.ts"
      },
      "configurations": {
        "release": {}
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["opentrack-ui:build", "opentrack-ui:sea"],
      "outputs": ["{workspaceRoot}/target/release/bundle"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tauri build"
      },
      "configurations": {
        "release": {
          "command": "tauri build --config tauri.updater.conf.json"
        }
      }
    }
  }
}

{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "aitrack-raycast",
  "version": "0.1.0",
  "private": true,
  "description": "Live Claude Code, Codex and Cursor limits, token usage and estimated cost.",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "author": "bircni",
  "type": "module",
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop"
  },
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "@raycast/utils": "^2.3.3",
    "aitrack-lib": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react": "19.0.0",
    "vitest": "catalog:"
  },
  "icon": "icon.png",
  "commands": [
    {
      "name": "limits",
      "title": "Show Limits",
      "subtitle": "aitrack",
      "description": "Live session and weekly limits with reset times and pacing.",
      "mode": "view"
    },
    {
      "name": "usage",
      "title": "Show Usage",
      "subtitle": "aitrack",
      "description": "Tokens and estimated cost per provider and model.",
      "mode": "view",
      "preferences": [
        {
          "name": "defaultPeriod",
          "type": "dropdown",
          "required": false,
          "default": "today",
          "title": "Default Period",
          "description": "Period shown when the command opens.",
          "data": [
            {
              "title": "Today",
              "value": "today"
            },
            {
              "title": "Yesterday",
              "value": "yesterday"
            },
            {
              "title": "This Week",
              "value": "thisweek"
            },
            {
              "title": "Last 7 Days",
              "value": "week"
            },
            {
              "title": "This Month",
              "value": "thismonth"
            },
            {
              "title": "Last 30 Days",
              "value": "month"
            },
            {
              "title": "Last 90 Days",
              "value": "last90"
            },
            {
              "title": "Last Month",
              "value": "lastmonth"
            },
            {
              "title": "All Time",
              "value": "all"
            }
          ]
        },
        {
          "name": "pullSyncedData",
          "type": "checkbox",
          "required": false,
          "default": true,
          "title": "Synced Data",
          "label": "Pull other machines' usage",
          "description": "git pull the aitrack data repo before loading, like opentrack."
        }
      ]
    }
  ],
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "claude",
      "type": "checkbox",
      "required": false,
      "default": true,
      "label": "Claude Code",
      "title": "Providers",
      "description": "Providers to show in both commands."
    },
    {
      "name": "codex",
      "type": "checkbox",
      "required": false,
      "default": true,
      "label": "Codex"
    },
    {
      "name": "cursor",
      "type": "checkbox",
      "required": false,
      "default": true,
      "label": "Cursor"
    },
    {
      "name": "display",
      "type": "dropdown",
      "required": false,
      "default": "used",
      "title": "Show Limits As",
      "description": "Show how much of each limit is used, or how much is left.",
      "data": [
        {
          "title": "Used",
          "value": "used"
        },
        {
          "title": "Left",
          "value": "left"
        }
      ]
    },
    {
      "name": "resetDisplay",
      "type": "dropdown",
      "required": false,
      "default": "absolute",
      "title": "Reset Times",
      "description": "Show when a limit resets as a time or as a countdown.",
      "data": [
        {
          "title": "Time",
          "value": "absolute"
        },
        {
          "title": "Countdown",
          "value": "relative"
        }
      ]
    }
  ],
  "title": "aitrack"
}

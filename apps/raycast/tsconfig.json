{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": ".typecheck",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "aitrack-lib/package.json": ["../../libs/aitrack-lib/package.json"],
      "aitrack-lib/*": ["../../libs/aitrack-lib/src/*.ts"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../../libs/aitrack-lib"
    }
  ]
}

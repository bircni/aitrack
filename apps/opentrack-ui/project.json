{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "opentrack-ui",
  "projectType": "application",
  "sourceRoot": "apps/opentrack-ui/src",
  "targets": {
    "lint": {},
    "format:check": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "tsc --build tsconfig.json --emitDeclarationOnly",
          "svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings"
        ],
        "parallel": false
      }
    },
    "check:unused": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --workspace opentrack-ui"
      }
    },
    "test": {
      "configurations": {
        "ci": {
          "coverage": true
        }
      }
    }
  }
}

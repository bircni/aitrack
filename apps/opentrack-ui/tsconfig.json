{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": ".typecheck",
    "paths": {
      "aitrack-lib": ["../../libs/aitrack-lib/src/index.ts"],
      "aitrack-lib/*": ["../../libs/aitrack-lib/src/*.ts"]
    }

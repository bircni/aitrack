{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "packages/aitrack/**/*",
        "packages/aitrack-lib/**/*",
        "packages/test-fixtures/**/*",
        "scripts/**/*"
      ],
      "options": {
        "compiler": "tsc",
        "typecheck": false,
        "build": {
          "targetName": "build",
          "configName": "tsconfig.build.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "packages/aitrack/**/*",
        "packages/aitrack-lib/**/*",
        "packages/test-fixtures/**/*",
        "scripts/**/*"
      ],
      "options": {
        "compiler": "tsc",
        "typecheck": {
          "targetName": "typecheck",
          "configName": "tsconfig.json"
        },
        "build": false
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    }
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/__tests__/**", "!{projectRoot}/vitest.config.ts"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"],
    "lintConfig": ["{workspaceRoot}/.oxlintrc.json"],
    "formatConfig": ["{workspaceRoot}/.oxfmtrc.json"],
    "repoTools": [
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/commitlint.config.ts",
      "{workspaceRoot}/knip.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "executor": "nx-oxlint:lint",
      "options": {
        "configFile": ".oxlintrc.json",
        "maxWarnings": 0,
        "additionalArguments": "--type-aware"
      },
      "inputs": ["default", "^production", "lintConfig"],
      "cache": true
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt --check {projectRoot}"
      },
      "inputs": ["default", "formatConfig"],
      "cache": true
    },
    "check:unused": {
      "inputs": ["default", "^production", "{workspaceRoot}/knip.json"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "configurations": {
        "ci": {
          "command": "vitest run --coverage"
        }
      }
    },
    "test:smoke": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        {
          "env": "SMOKE_CLI"
        }
      ],
      "cache": true
    }
  },
  "analytics": false
}

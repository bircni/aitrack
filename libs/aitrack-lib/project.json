{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "aitrack-lib",
  "projectType": "library",
  "sourceRoot": "libs/aitrack-lib/src",
  "targets": {
    "lint": {},
    "format:check": {},
    "check:unused": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --workspace aitrack-lib"
      }
    },
    "package:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "platform"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npm pack --dry-run"
      }
    },
    "test": {
      "configurations": {
        "ci": {
          "coverage": true
        }
      }
    },
    "mutation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "stryker run",
        "env": { "TZ": "UTC" }
      }
    }
  }
}

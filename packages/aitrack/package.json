  },
  "devDependencies": {
    "@aitrack/test-fixtures": "workspace:*",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}

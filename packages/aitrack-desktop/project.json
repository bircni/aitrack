{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "aitrack-desktop",
  "projectType": "application",
  "sourceRoot": "packages/aitrack-desktop/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/out"],
      "options": {
        "command": "electron-vite build",
        "cwd": "{projectRoot}"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "electron-builder --publish never",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "playwright test",
        "cwd": "{projectRoot}"
      }
    },
    "format:check": {},
    "check:unused": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --workspace aitrack-desktop"
      }
    }
  }
}

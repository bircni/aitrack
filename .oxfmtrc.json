{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "coverage",
    "dist",
    "dist-sidecar",
    "apps/opentrack",
    "node_modules",
    "aitrack*.png",
    "CHANGELOG.md",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ]
}

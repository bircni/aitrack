{
  "name": "aitrack-workspace",
  "version": "4.0.0",
  "private": true,
  "description": "Monorepo for aitrack (the CLI) and aitrack-lib (the core library).",
  "homepage": "https://github.com/bircni/aitrack#readme",
  "bugs": {
    "url": "https://github.com/bircni/aitrack/issues"
  },
  "license": "MIT",
  "author": "Nicolas <bircni@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bircni/aitrack.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ],
    "catalog": {
      "@types/node": "^26.6.5",
      "@typescript/native": "npm:typescript@^7.0.2",
      "@vitest/coverage-v8": "^5.0.5",
      "chalk": "^6.0.1",
      "tsx": "^4.23.15",
      "typescript": "npm:@typescript/typescript6@^6.0.2",
      "vitest": "^5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run aitrack:build && cd apps/aitrack && tsx src/cli.ts",
    "lint": "nx run-many -t lint",
    "format": "oxfmt",
    "format:check": "nx run-many -t format:check",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:ci": "nx run-many -t test --configuration ci",
    "test:scripts": "nx run repo-tools:test",
    "test:smoke": "nx run aitrack:test:smoke",
    "check:unused": "nx run-many -t check:unused",
    "mutation": "nx run aitrack-lib:mutation",
    "validate": "nx run-many -t format:check,lint,typecheck,check:unused,test,build --configuration ci",
    "validate:affected": "nx affected -t format:check,lint,typecheck,check:unused,test,build --configuration ci",
    "graph": "nx graph",
    "pricing:check": "nx run repo-tools:pricing:check",
    "pricing:update": "nx run repo-tools:pricing:update",
    "changelog": "nx run repo-tools:changelog",
    "release": "nx run repo-tools:release",
    "release:dry-run": "nx run repo-tools:release -- patch --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@monodon/rust": "3.0.0",
    "@nx/esbuild": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "0.28.2",
    "git-cliff": "^2.14.2",
    "knip": "^6.43.0",
    "nx": "24.0.2",
    "nx-oxlint": "0.1.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "simple-git-hooks": "^2.14.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@nx/devkit": {
      "minimatch": "10.2.6"
    },
    "nx": {
      "minimatch": "10.2.6",
      "undici": "^7.30.1"
    },
    "typed-rest-client": {
      "qs": "^6.17.0"
    }
  },
  "simple-git-hooks": {
    "commit-msg": "bun x commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "simple-git-hooks",
    "nx"
  ]
}

{
  "name": "aitrack-workspace",
  "private": true,
  "description": "Tooling for the opentrack renderer and the release scripts; the CLI and app are Rust.",
  "homepage": "https://github.com/bircni/aitrack#readme",
  "bugs": {
    "url": "https://github.com/bircni/aitrack/issues"
  },
  "license": "MIT",
  "author": "Nicolas <bircni@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bircni/aitrack.git"
  },
  "workspaces": {
    "packages": [
      "apps/opentrack-ui"
    ],
    "catalog": {
      "@types/node": "^26.6.6",
      "@typescript/native": "npm:typescript@^7.0.2",
      "@vitest/coverage-v8": "^5.1.0",
      "typescript": "npm:@typescript/typescript6@^6.0.2",
      "vitest": "^5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "validate": "just validate",
    "format": "oxfmt",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "git-cliff": "^2.14.2",
    "knip": "^6.44.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "simple-git-hooks": "^2.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.17.0"
    }
  },
  "simple-git-hooks": {
    "commit-msg": "bun x commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "simple-git-hooks"
  ]
}

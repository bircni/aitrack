{
  "name": "aitrack-workspace",
  "version": "2.1.0",
  "private": true,
  "description": "Monorepo for aitrack (the CLI) and aitrack-lib (the core library).",
  "homepage": "https://github.com/bircni/aitrack#readme",
  "bugs": {
    "url": "https://github.com/bircni/aitrack/issues"
  },
  "license": "MIT",
  "author": "Nicolas <bircni@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bircni/aitrack.git"
  },
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run aitrack:build && pnpm --filter aitrack exec tsx src/cli.ts",
    "lint": "nx run-many -t lint",
    "format": "oxfmt",
    "format:check": "nx run-many -t format:check",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:ci": "nx run-many -t test --configuration ci",
    "test:scripts": "nx run repo-tools:test",
    "test:smoke": "nx run aitrack:test:smoke",
    "check:unused": "nx run-many -t check:unused",
    "validate": "nx run-many -t format:check,lint,typecheck,check:unused,test,build --configuration ci",
    "validate:affected": "nx affected -t format:check,lint,typecheck,check:unused,test,build --configuration ci",
    "graph": "nx graph",
    "pricing:check": "nx run repo-tools:pricing:check",
    "changelog": "nx run repo-tools:changelog",
    "release": "nx run repo-tools:release",
    "release:dry-run": "nx run repo-tools:release -- patch --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@nx/js": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "git-cliff": "^2.13.1",
    "knip": "^6.35.1",
    "nx": "^23.2.1",
    "nx-oxlint": "0.1.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.14.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}

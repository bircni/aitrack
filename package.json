{
  "name": "aitrack",
  "version": "1.5.0",
  "description": "Track and visualize your Claude Code, Codex & Cursor usage and cost — heatmaps, stats, and multi-machine sync over a git repo you own.",
  "keywords": [
    "ai",
    "ai-usage",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "cost-tracking",
    "cursor",
    "developer-tools",
    "git-sync",
    "heatmap",
    "openai",
    "token-usage",
    "tui",
    "usage"
  ],
  "homepage": "https://github.com/bircni/aitrack#readme",
  "bugs": {
    "url": "https://github.com/bircni/aitrack/issues"
  },
  "license": "MIT",
  "author": "Nicolas <bircni@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bircni/aitrack.git"
  },
  "bin": {
    "aitrack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "vitest run src/cli/__tests__/smoke.test.ts",
    "pricing:check": "tsx scripts/update-pricing.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:unused": "knip",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run coverage && pnpm run check:unused",
    "changelog": "git-cliff --config .cliff.toml -o CHANGELOG.md",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts patch --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "pdfkit": "^0.20.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.4.1",
    "@types/pdfkit": "^0.17.6",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^5.0.0",
    "git-cliff": "^2.13.1",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}

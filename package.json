{
  "name": "aitrack",
  "version": "0.3.1",
  "description": "Sync AI coding assistant usage across machines via GitHub",
  "author": "Nicolas <bircni@icloud.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bircni/aitrack.git"
  },
  "homepage": "https://github.com/bircni/aitrack#readme",
  "bugs": {
    "url": "https://github.com/bircni/aitrack/issues"
  },
  "keywords": [
    "ai",
    "claude",
    "codex",
    "cursor",
    "usage",
    "heatmap",
    "git-sync",
    "cli"
  ],
  "type": "module",
  "packageManager": "pnpm@11.5.2+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aitrack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run src/cli/__tests__/smoke.test.ts",
    "pricing:check": "tsx scripts/update-pricing.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:unused": "knip",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run check:unused",
    "changelog": "git-cliff --config .cliff.toml -o CHANGELOG.md",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs patch --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.2",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.19",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^65.0.0",
    "git-cliff": "^2.13.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "knip": "^6.16.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}

{
  "name": "aitrack",
  "version": "1.3.1",
  "description": "Track and visualize your Claude Code, Codex & Cursor usage and cost — heatmaps, stats, and multi-machine sync over a git repo you own.",
  "keywords": [
    "ai",
    "ai-usage",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "cost-tracking",
    "cursor",
    "developer-tools",
    "git-sync",
    "heatmap",
    "openai",
    "token-usage",
    "tui",
    "usage"
  ],
  "homepage": "https://github.com/bircni/aitrack#readme",
  "bugs": {
    "url": "https://github.com/bircni/aitrack/issues"
  },
  "license": "MIT",
  "author": "Nicolas <bircni@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bircni/aitrack.git"
  },
  "bin": {
    "aitrack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "vitest run src/cli/__tests__/smoke.test.ts",
    "pricing:check": "tsx scripts/update-pricing.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:unused": "knip",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run check:unused",
    "changelog": "git-cliff --config .cliff.toml -o CHANGELOG.md",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs patch --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "pdfkit": "^0.19.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.1.10",
    "git-cliff": "^2.13.1",
    "knip": "^6.31.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
